{
  "name": "@corbits/cron",
  "version": "0.2.0",
  "description": "Cron schedules for an Interchange hub: grant-gated schedule routes plus a ticker that turns a due row into run-trigger mail",
  "homepage": "https://github.com/corbitsdev/corbits-cron",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-cron/issues"
  },
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-cron.git"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:e2e": "bun test ./e2e",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "arktype": "^2.2.3"
  },
  "devDependencies": {
    "@corbits/cron-0.1.0": "npm:@corbits/cron@0.1.0",
    "@intx/db": "0.4.0",
    "@intx/hub-api": "0.4.0",
    "@types/bun": "1.3.9",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.8",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "postgres": "3.4.9",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@intx/db": "^0.4.0",
    "@intx/hub-api": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "postgres": "^3.4.9"
  },
  "engines": {
    "node": ">=24"
  }
}
