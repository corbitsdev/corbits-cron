{
  "name": "@corbits/cron",
  "version": "0.1.0",
  "description": "Cron schedules for an Interchange hub: a CRUD mount plus a ticker that turns a due row into run-trigger mail",
  "license": "LGPL-2.1-only",
  "author": "Sawyer Cutler <sawyer@dirtroad.dev>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": {
      "types": "./dist/migrations.d.ts",
      "default": "./dist/migrations.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corbitsdev/corbits-cron.git"
  },
  "homepage": "https://github.com/corbitsdev/corbits-cron",
  "bugs": {
    "url": "https://github.com/corbitsdev/corbits-cron/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src"
  },
  "dependencies": {
    "arktype": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.11.9",
    "postgres": "^3.4.8",
    "@intx/db": "^0.4.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "typescript": "5.9.3"
  }
}
